FROM node:24.18.0-alpine AS build

WORKDIR /app

COPY package*.json ./

RUN npm install

COPY . .

RUN npm run build

FROM nginx:1.25.2-alpine

# Replace the stock default site (which is auto-included from /etc/nginx/conf.d/).
# Our nginx.conf contains ONLY http-context directives so the include is valid.
COPY --from=build /app/dist /usr/share/nginx/html
COPY --from=build /app/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80 443

CMD ["nginx", "-g", "daemon off;"]
